# Copy this file to .env and fill in the values before deploying to AWS.
# .env is gitignored — never commit the actual secrets.

# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars

# Your CloudFront HTTPS URL (set after Step 14 in the deployment guide)
# Example: https://d1abc123xyz.cloudfront.net
FRONTEND_ORIGIN=*
